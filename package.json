{
  "name": "webmail-app",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/ && cp -r .next/server .next/standalone/.next/",
    "start": "node .next/standalone/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run && npm run typecheck",
    "test:watch": "vitest",
    "collab": "node --env-file-if-exists=.env scripts/collab-server.mjs",
    "worker:sync": "ts-node src/workers/sync.ts",
    "worker:send": "ts-node src/workers/send.ts",
    "worker:mattermost": "ts-node src/workers/mattermost.ts",
    "worker:push": "ts-node src/workers/push.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@prisma/client": "^5.13.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@tiptap/extension-collaboration": "^3.32.0",
    "@tiptap/extension-collaboration-caret": "^3.32.0",
    "@tiptap/extension-color": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/y-tiptap": "^3.0.10",
    "@types/dompurify": "^3.0.5",
    "@types/sanitize-html": "^2.16.2",
    "cookie": "^1.1.1",
    "dompurify": "^3.4.17",
    "imapflow": "^1.7.8",
    "iron-webcrypto": "^0.10.1",
    "lightweight-charts": "^5.2.1",
    "mailparser": "^3.12.4",
    "natural": "^8.2.3",
    "next": "^16.4.3",
    "nodemailer": "^10.2.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanitize-html": "^2.18.1",
    "swr": "^2.5.1",
    "web-push": "^3.6.6",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "y-webrtc": "^10.3.0",
    "y-websocket": "^1.5.4",
    "yjs": "^13.6.31",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mailparser": "^3.9.0",
    "@types/natural": "^5.1.5",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.2.25",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.31",
    "prisma": "^5.13.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
